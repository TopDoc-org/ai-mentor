# Copy this file to android/keystore.properties and fill in real values, then
# keep keystore.properties OUT of version control. Generate a keystore with:
#   keytool -genkey -v -keystore zenamaze-release.jks -keyalias zenamaze \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is resolved relative to the android/ directory.
storeFile=zenamaze-release.jks
storePassword=CHANGE_ME
keyAlias=zenamaze
keyPassword=CHANGE_ME
